# ===== Publik (disajikan saat runtime lewat GET /api/config) =====
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# ===== Rahasia server (JANGAN di-commit) =====
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL internal (source of truth). Di VPS yura-infra: host = yura-postgres
DATABASE_URL=postgresql://papanote_user:password@localhost:5432/papanote
# Dikirim Supabase Database Webhook pada header "x-webhook-secret"
WEBHOOK_SECRET=
# Generate dengan: bun run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yuramedia.com

# ===== Kebijakan retensi =====
HISTORY_RETENTION_DAYS=30
# 0 = simpan riwayat selamanya di Postgres internal
HISTORY_RETENTION_DAYS_INTERNAL=30
DELETED_CARD_GRACE_DAYS=7

# ===== Job (set false untuk menonaktifkan) =====
JOBS_ENABLED=true

PORT=3000
