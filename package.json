{
  "name": "papanote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Papan catatan visual tim — Svelte + Supabase realtime + PostgreSQL internal",
  "scripts": {
    "dev": "bun run --parallel dev:web dev:server",
    "dev:web": "vite",
    "dev:server": "bun --watch server/index.ts",
    "build": "vite build",
    "start": "bun server/worker.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "create-user": "bun scripts/create-user.ts",
    "vapid": "bun scripts/generate-vapid.ts",
    "migrate": "bun scripts/run-migrations.ts",
    "seed": "bun scripts/seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "marked": "^18.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/marked": "^6.0.0",
    "@types/web-push": "^3.6.4",
    "bits-ui": "^2.19.5",
    "docx": "^9.10.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-dnd-action": "^0.9.80",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9",
    "vite": "^8.3.4"
  }
}